# In-House AI Image-to-Video Studio Configuration
# 100% Keyless & Offline-Capable (Works in Antigravity, Claude Desktop, Codex, or Browser)

PORT=3000
DEFAULT_RESOLUTION=1080p
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_DURATION_SECONDS=4
FIXED_FPS=30
# Optional: path to a Chromium-family browser for `npm run render` / `npm run test:e2e`
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
